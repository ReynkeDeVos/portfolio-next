{
  "name": "portfolio-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "aubr content:check && vite",
    "build": "aubr content:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/selected-work.test.ts scripts/dependency-security.test.mjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "deploy": "aubr build && wrangler deploy",
    "check": "aubr content:check && aubr test && aubr typecheck && aubr lint && aubr format:check",
    "content:check": "node scripts/validate-content.ts"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@oxlint/plugins": "^1.86.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.145.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "aube@2.6.1"
}
