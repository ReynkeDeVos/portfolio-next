{
  "name": "portfolio-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nub exec --no-check vite --host 0.0.0.0 --port 3000",
    "build": "aube run content:check && nub exec --no-check vite build",
    "preview": "nub exec --no-check vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "nub exec --no-check tsc --noEmit",
    "lint": "nub exec --no-check oxlint --type-aware",
    "format": "nub exec --no-check oxfmt --write .",
    "format:check": "nub exec --no-check oxfmt --check .",
    "deploy": "aube run build && nub exec --no-check wrangler deploy",
    "check": "aube run content:check && aube run typecheck && aube run lint && aube run format:check",
    "content:check": "nub scripts/validate-content.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "aube@2.6.1"
}
